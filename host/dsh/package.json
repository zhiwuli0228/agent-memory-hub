{
  "name": "agent-memory-hub-dsh",
  "version": "0.1.0",
  "description": "DSH host adapter for agent-memory-hub — thin cordis plugin shell; all memory logic lives in agent-memory-hub core.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run test"
  },
  "devDependencies": {
    "agent-memory-hub": "file:../..",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
