{
  "name": "agent-memory-hub",
  "version": "0.1.13",
  "description": "Agent memory bridge — local-first, human-approved, file-native long-term memory for AI coding agents (Claude Code, Codex, opencode, gemini, DSH). One local service, every agent shares it.",
  "keywords": [
    "agent-memory",
    "agent-memory-bridge",
    "memory",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "opencode",
    "cross-host",
    "local-first",
    "knowledge-base",
    "long-term-memory"
  ],
  "license": "MIT",
  "author": "zhiwuli0228",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiwuli0228/agent-memory-hub.git"
  },
  "homepage": "https://github.com/zhiwuli0228/agent-memory-hub#readme",
  "bugs": {
    "url": "https://github.com/zhiwuli0228/agent-memory-hub/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "memhub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run test",
    "check:host": "npm --prefix host/dsh run check",
    "prepublishOnly": "npm run check && node -e \"const p=require('./package.json'); if(!/^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$/.test(p.version)) { console.error('bad version'); process.exit(1) }\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
